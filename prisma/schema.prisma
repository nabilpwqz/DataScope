// Prisma Schema for DataScope - Enterprise Data Discovery & Intelligence Platform
// Supports PostgreSQL 15+ with pg_trgm and full-text search indexing

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  admin
  analyst
  viewer
}

enum AccessLevel {
  public
  restricted
  admin_only
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(viewer)
  department   String
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  savedViews   SavedView[]
  searches     SearchHistory[]
  exportJobs   ExportJob[]

  @@map("users")
}

model Dataset {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  description      String
  category         String
  dataSource       String       @map("data_source")
  totalRecords     Int          @default(0) @map("total_records")
  accessLevel      AccessLevel  @default(public) @map("access_level")
  schemaDefinition Json         @default("[]") @map("schema_definition")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  fields           DatasetField[]
  records          DatasetRecord[]
  savedViews       SavedView[]
  searches         SearchHistory[]
  exportJobs       ExportJob[]

  @@map("datasets")
}

model DatasetField {
  id           String   @id @default(cuid())
  datasetId    String   @map("dataset_id")
  fieldName    String   @map("field_name")
  displayName  String   @map("display_name")
  dataType     String   @map("data_type") // string | number | boolean | date | currency
  isFilterable Boolean  @default(true) @map("is_filterable")
  isSearchable Boolean  @default(true) @map("is_searchable")
  isSortable   Boolean  @default(true) @map("is_sortable")
  isPrimary    Boolean  @default(false) @map("is_primary")
  sampleValues Json?    @default("[]") @map("sample_values")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dataset      Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId], map: "fields_dataset_id_idx")
  @@map("dataset_fields")
}

model DatasetRecord {
  id           String   @id @default(cuid())
  datasetId    String   @map("dataset_id")
  recordKey    String   @map("record_key")
  title        String
  category     String
  status       String   // Active | Pending | Archived | Suspended | Completed | Flagged
  numericValue Float    @default(0) @map("numeric_value")
  country      String
  region       String
  recordDate   DateTime @map("record_date") @db.Timestamptz(6)
  metadata     Json     @default("{}")
  searchVector String?  @map("search_vector")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dataset      Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  history      RecordHistory[]

  @@index([datasetId], map: "records_dataset_id_idx")
  @@index([datasetId, status], map: "records_status_idx")
  @@index([datasetId, category], map: "records_category_idx")
  @@index([datasetId, country], map: "records_country_idx")
  @@index([datasetId, numericValue], map: "records_numeric_val_idx")
  @@index([datasetId, recordDate], map: "records_record_date_idx")
  @@index([recordKey], map: "records_record_key_idx")
  @@map("dataset_records")
}

model RecordRelationship {
  id               String   @id @default(cuid())
  sourceRecordId   String   @map("source_record_id")
  targetRecordId   String   @map("target_record_id")
  relationshipType String   @map("relationship_type")
  metadata         Json?    @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sourceRecordId], map: "rel_source_idx")
  @@index([targetRecordId], map: "rel_target_idx")
  @@map("record_relationships")
}

model RecordHistory {
  id              String        @id @default(cuid())
  recordId        String        @map("record_id")
  changedByUserId String        @map("changed_by_user_id")
  changedByName   String        @map("changed_by_name")
  changeType      String        @map("change_type")
  diffPayload     Json          @default("{}") @map("diff_payload")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  record          DatasetRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId], map: "history_record_id_idx")
  @@map("record_history")
}

model SavedView {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  datasetId             String   @map("dataset_id")
  name                  String
  description           String?
  isShared              Boolean  @default(false) @map("is_shared")
  authorName            String?  @map("author_name")
  searchQuery           String?  @default("") @map("search_query")
  searchType            String?  @default("hybrid") @map("search_type")
  filterConfig          Json     @default("[]") @map("filter_config")
  filterLogicalOperator String   @default("AND") @map("filter_logical_operator")
  sortConfig            Json     @default("[]") @map("sort_config")
  visibleColumns        Json     @default("[]") @map("visible_columns")
  pageSize              Int      @default(25) @map("page_size")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset               Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([userId, datasetId], map: "saved_views_user_dataset_idx")
  @@index([datasetId, isShared], map: "saved_views_shared_idx")
  @@map("saved_views")
}

model SearchHistory {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  datasetId       String   @map("dataset_id")
  queryText       String   @map("query_text")
  searchType      String   @default("hybrid") @map("search_type")
  filterSummary   Json     @default("[]") @map("filter_summary")
  resultCount     Int      @default(0) @map("result_count")
  executionTimeMs Float    @default(0) @map("execution_time_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset         Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([userId, datasetId], map: "search_hist_user_idx")
  @@map("search_history")
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  tableDensity         String   @default("standard") @map("table_density")
  theme                String   @default("dark")
  autoRefresh          Boolean  @default(false) @map("auto_refresh")
  refreshIntervalSec   Int      @default(30) @map("refresh_interval_sec")
  defaultPageSize      Int      @default(25) @map("default_page_size")
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_preferences")
}

model ExportJob {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  datasetId      String    @map("dataset_id")
  format         String    @default("csv")
  status         String    @default("pending") // pending | processing | completed | failed
  filterCriteria Json?     @default("{}") @map("filter_criteria")
  totalRows      Int       @default(0) @map("total_rows")
  fileUrl        String?   @map("file_url")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset        Dataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@map("export_jobs")
}

model QueryPerformanceLog {
  id                  String   @id @default(cuid())
  endpoint            String
  queryType           String   @map("query_type")
  queryHash           String   @map("query_hash")
  executionTimeMs     Float    @map("execution_time_ms")
  totalRecordsScanned Int      @default(0) @map("total_records_scanned")
  cacheHit            Boolean  @default(false) @map("cache_hit")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "perf_created_idx")
  @@map("query_performance_logs")
}
