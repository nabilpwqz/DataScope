# DataScope Enterprise Environment Variables

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Secret (JWT signing)
JWT_SECRET=datascope-enterprise-super-secure-production-jwt-secret-key-32chars

# Database Configuration (Optional for Vercel / Cloud Deployments)
# If left blank, DataScope will run in embedded WebAssembly PostgreSQL (PGlite) mode with auto-seeding.
# To connect to external PostgreSQL (e.g. Neon, Supabase, AWS RDS, Render):
# DATABASE_URL=postgresql://username:password@ep-cool-server.us-east-2.aws.neon.tech/neondb?sslmode=require

# Node Environment
NODE_ENV=production
