# DataScope Environment Configuration
NODE_ENV=development
PORT=3000

# Authentication Secret
JWT_SECRET=datascope-super-secure-production-ready-jwt-token-key-32-chars-min

# PostgreSQL Configuration
# Set DATABASE_URL to connect to external Postgres (e.g., postgresql://postgres:password@localhost:5432/datascope)
# If left empty or undefined, DataScope automatically initializes embedded WebAssembly PostgreSQL (PGlite)
# with persistence in .pgdata and full pg_trgm & Full-Text Search support!
DATABASE_URL=
PG_DATA_DIR=.pgdata

# Search Engine Strategy (postgres_fts | postgres_trgm | hybrid)
SEARCH_STRATEGY=hybrid

# Cache Configuration
CACHE_TTL_MS=60000
